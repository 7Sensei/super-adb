QWidget {
    background-color: $bg;
    color: $text;
    selection-background-color: $accent;
    selection-color: $accent_text;
    font-family: "$font_family";
    font-size: 10pt;
}

QMainWindow, QDialog {
    background-color: $bg;
}

QFrame#surface, QFrame#panel, QFrame#card {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 14px;
}

QFrame#raised {
    background-color: $raised;
    border: 1px solid $border;
    border-radius: 12px;
}

QPushButton, QToolButton, QComboBox, QLineEdit {
    background-color: $raised;
    border: 1px solid $border;
    border-radius: 10px;
    padding: 8px 12px;
}

QPushButton:hover, QToolButton:hover, QComboBox:hover {
    border-color: $accent;
}

QPushButton:disabled, QToolButton:disabled {
    color: $muted;
    background-color: $surface;
}

QPushButton[variant="primary"] {
    background-color: $accent;
    color: $accent_text;
    border-color: $accent;
}

QPushButton[variant="danger"] {
    color: $danger_text;
}

QPlainTextEdit, QTextEdit, QScrollArea {
    background-color: $surface;
    border: 1px solid $border;
    border-radius: 10px;
}

QScrollBar:vertical {
    background: $surface;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: $border;
    border-radius: 4px;
    min-height: 24px;
}

QToolTip {
    background-color: $raised;
    color: $text;
    border: 1px solid $border;
    padding: 5px;
}
